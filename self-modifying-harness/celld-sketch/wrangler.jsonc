// UNTESTED SKETCH: celld's release binary could not be downloaded in the environment this was written in.
// The shape follows celld's `facets` and `dynamic-worker-tails` examples (worker_loaders + a SQLite Durable Object).
{
  "name": "forge",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": { "bindings": [{ "name": "FORGE", "class_name": "Forge" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Forge"] }]
}
