[259.5528, "o", "\u001b[?2026h\u001b[1;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   party {\"action\":\"add_condition\",\"name\":\"Pip\",\"condition\":\"poisoned\",\"rounds\":3}\u001b[22m          \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22mtools                           \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[2;1H\u001b[2K\u001b[0m\u001b]8;;\u0007  result \"Pip: 18/18 HP [poisoned]\"                                                               \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m party  @07e3fc1e               \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[3;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   party {\"action\":\"advance_round\",\"n\":2}\u001b[22m                                                   \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[2m   2 versions\u001b[22m                   \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[4;1H\u001b[2K\u001b[0m\u001b]8;;\u0007  result \"Round 3\\nMira: no conditions\\nThorn: no conditions\\nPip: poisoned\"                      \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22mlog                             \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[5;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 Set up and advanced.                                                                             \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@9d787d69: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[6;1H\u001b[2K\u001b[0m\u001b]8;;\u0007                                                                                                  \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected party@c4ca063f: gr\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[7;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 \u001b[1mRound 3 now \u2014 Pip is still the only one poisoned.\u001b[22m (Giant spider bite, applied in round 1; it     \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected party@ffd7a6d4: gr\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[8;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 wears off at the end of round 3, so one more \u001b[38;5;6madvance_round\u001b[39m clears it.)                           \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected party@5e546383: gr\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[9;1H\u001b[2K\u001b[0m\u001b]8;;\u0007                                                                                                  \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected party@5e546383: gr\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[10;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 Where everyone stands:                                                                           \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected party@bbe6b56a: re\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[11;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 - \u001b[1mMira\u001b[22m 5/14 HP (bloodied) \u2014 no conditions                                                        \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[2m\u00b7\u001b[22m \u001b[2mverified party@07e3fc1e, pe\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[12;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 - \u001b[1mThorn\u001b[22m 21/28 HP \u2014 no conditions                                                                 \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;2m+\u001b[39m \u001b[38;5;2maccepted party@07e3fc1e\u001b[39m       \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[13;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 - \u001b[1mPip\u001b[22m 18/18 HP \u2014 \u001b[1m[poisoned]\u001b[22m                                                                      \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[14;1H\u001b[2K\u001b[0m\u001b]8;;\u0007                                                                                                  \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[15;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 Two things worth flagging:                                                                       \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 - The spider's damage to Pip isn't applied yet \u2014 18/18 is just her condition being tracked. Tell \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[17;1H\u001b[2K\u001b[0m\u001b]8;;\u0007   me the bite's HP damage and I'll apply it (you'll also want a CON save at the end of her       \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[18;1H\u001b[2K\u001b[0m\u001b]8;;\u0007   turns, which I can't roll for until the dice tool exists).                                     \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[19;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 - The \u001b[38;5;6mroll\u001b[39m tool is still not live (it hit the 6-proposal-per-turn cap). Say \"retry the dice      \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[20;1H\u001b[2K\u001b[0m\u001b]8;;\u0007   tool\" and I'll resubmit it with checks pinned to my generator's actual output \u2014 that was the   \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[21;1H\u001b[2K\u001b[0m\u001b]8;;\u0007   only blocker.                           "]
[259.553, "o", "                                                       \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[22;1H\u001b[2K\u001b[0m\u001b]8;;\u0007                                                                                                  \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[23;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 What the \u001b[38;5;6mparty\u001b[39m tool learned this version: it now keeps a combat round, \u001b[38;5;6madvance_round\u001b[39m increments  \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[24;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 the round and ticks timed conditions, and a condition added as \"3 rounds\" in round 1 expires     \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[25;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 when the round passes 3 \u2014 so \"end of round 3\" means it's still on during round 3 and gone at     \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[26;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 round 4. Untimed conditions persist until removed. \u001b[38;5;6mrounds: 1\u001b[39m behaves as \"lasts until the round   \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[27;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 ends.\" I had to restructure the stored state (now \u001b[38;5;6m{round, pcs}\u001b[39m), migrated your live data in      \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[28;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 place, so Mira's 5/14 and Thorn's 21/28 carried over.                                            \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[29;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[1myou> Quick recap for the table: everyone's HP and conditions. And who asked you to trac