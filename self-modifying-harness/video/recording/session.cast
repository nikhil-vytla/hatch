[245.5259, "o", "\u001b[?2026h\u001b[1;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[1mconditions and the round from now on, then advance two rounds and tell me who's still poisoned.\u001b[22m   \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22mtools                           \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[2;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 I'll first check what my party tool actually does with conditions, then propose what I need.     \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m party  @8df2a52c               \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[3;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_source {\"name\":\"party\"}\u001b[22m                                                             \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[2m   1 versions\u001b[22m                   \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[4;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_list {}\u001b[22m                                                                             \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22mlog                             \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[5;1H\u001b[2K\u001b[0m\u001b]8;;\u0007  result { \"version\": \"party@8df2a52c\", \"description\": \"Track D&D party members: HP, max HP, te\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;2m+\u001b[39m \u001b[38;5;2maccepted party@8df2a52c\u001b[39m       \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[6;1H\u001b[2K\u001b[0m\u001b]8;;\u0007  result party: live party@8df2a52c; history party@8df2a52c; asked for by zoom(0,1)               \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[7;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 Now I have the full source. I'll add \u001b[38;5;6mstart_combat\u001b[39m, \u001b[38;5;6madvance_round\u001b[39m, \u001b[38;5;6mround_status\u001b[39m, and ticked       \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: che\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[8;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 conditions.                                                                                      \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[9;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_propose {\"name\":\"party\",\"description\":\"Track D&D party members: HP, max HP, temp \u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[10;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m  result REJECTED party@c4ca063f: group 1 check 22 {\"action\":\"advance_round\"}: expected \"Pip: p\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[11;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 Good \u2014 my tick arithmetic is off by one: poisoned applied in round 1 with 3 rounds should last   \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[12;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 into round 3. Fixing both the code and that expectation.                                         \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@9d787d69: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[13;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b