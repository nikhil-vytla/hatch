5;6md20: 1\u001b[39m; \u001b[38;5;6md20 x3\u001b[39m seed 1 \u2192 \u001b[38;5;6md20 x3: [1, 1, 13] (total 15)\u001b[39m; \u001b[38;5;6mroll 2d6+3\u001b[39m   \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[8;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 seed 3 \u2192 \u001b[38;5;6m2d6+3: [1, 1] + 3 = 5\u001b[39m; \u001b[38;5;6mroll d8\u001b[39m seed 1 \u2192 \u001b[38;5;6md8: [1] = 1\u001b[39m; \u001b[38;5;6mroll 4\u001b[39m \u2192 \u001b[38;5;6m4\u001b[39m; plus \u001b[38;5;6minit\u001b[39m seed 3 with  \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: che\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[9;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 Mira +2 / Thorn +1 \u2192 their known totals. That should pass on the next turn. Note the tool's      \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[10;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 \u001b[3msource\u001b[23m was never the problem \u2014 only my expected-value guesses.                                   \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[11;1H\u001b[2K\u001b[0m\u001b]8;;\u0007                                                                                                  \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[12;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 \u001b[1mMeanwhile, the turn order you asked for\u001b[22m \u2014 rather than leave you waiting mid-combat, here are     \u001b[0m\u