[98.7433, "o", "\u001b[?2026h\u001b[1;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 below 0 HP, marks anyone at half HP or less as \u001b[1m(bloodied)\u001b[22m and anyone at 0 as \u001b[1m\u001b[1mDOWN\u001b[22m\u001b[22m, and tracks    \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22mtools                           \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[2;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 temporary HP (absorbed before real HP) and conditions (poisoned, prone, etc. \u2014 clear them when   \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m party  @8df2a52c               \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[3;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 they wear off).                                                                                  \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[2m   1 versions\u001b[22m                   \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[4;1H\u001b[2K\u001b[0m\u001b]8;;\u0007                                                                                                  \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22mlog                             \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[5;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 Two things that will matter later:                                                               \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected party@8df2a52c: ch\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[6;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 - I assumed each character's listed HP is also their max. If any of them has a different max (or \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected party@8df2a52c: gr\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[7;1H\u001b[2K\u001b[0m\u001b]8;;\u0007   a CON bump, temp HP, or a different HP on the sheet), tell me and I'll correct it.             \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected party@8df2a52c: gr\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[8;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 - I don't track death saves or spell slots yet. Say the word and I'll add them.                  \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[2m\u00b7\u001b[22m \u001b[2mverified party@8df2a52c, pe\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[9;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[1myou> Combat! Roll initiative: Mira +2, Thorn +1, Pip +4, and three goblins at +2 each. Roll a d20 \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;2m+\u001b[39m \u001b[38;5;2maccepted party@8df2a52c\u001b[39m       \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[10;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[1mfor everyone and give me the turn order.\u001b[22m                                                          \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[11;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 I'll build a dice tool \u2014 randomness needs to be exactly right, so it gets its own tool with      \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[12;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 injectable randomness for checks.                                                                \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[13;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_list {}\u001b[22m                                                                             \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[14;1H\u001b[2K\u001b[0m\u001b]8;;\u0007  result party: live party@8df2a52c; history party@8df2a52c; asked for by zoom(0,1)               \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[15;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_propose {\"name\":\"roll\",\"description\":\"Roll dice for D&D: init (d20 + mods, sorted\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m  result REJECTED roll@3a23bd60: group 0 check 0 {\"action\":\"d20\",\"seed\":1}: expected \"d20: 11\",\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[17;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 I need my expected values to match my own xorshift output, not guesses. Let me pin the actual    \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[18;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 sequence with a deterministic low-risk check set.                                                \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[19;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_propose {\"checks\":[{\"args\":{\"action\":\"d20\",\"seed\":1},\"expect\":\"d20: 1\"},{\"args\":{\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[20;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m  result REJECTED roll@3a23bd60: checks do not exercise every action: action=\"init\" appear in n\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[22;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m  result REJECTED roll@3a23bd60: group 0 check 1 {\"action\":\"d20\",\"n\":3,\"seed\":1}: expected \"d20\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[24;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m"]
[98.7434, "o", "  result REJECTED roll@3a23bd60: group 0 check 2 {\"action\":\"roll\",\"expr\":\"2d6+3\",\"seed\":3}: exp\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[26;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m  result REJECTED roll@3a23bd60: group 0 check 3 {\"action\":\"roll\",\"expr\":\"d8\",\"seed\":1}: expect\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[28;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m  result REJECTED roll@3a23bd60: group 0 check 5 {\"action\":\"init\",\"seed\":3,\"combatants\":[{\"mod\"\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[30;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m  result REFUSED: 6 proposals were rejected in this turn. Stop proposing, and tell the user wha\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[32;2H\u001b[?25l\u001b[?2026l"]
