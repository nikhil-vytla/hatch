[232.1653, "o", "\u001b[?2026h\u001b[1;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[1myou> A giant spider bites Pip: poisoned until the end of round 3, and we're in round 1. Track     \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22mtools                           \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[2;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[1mconditions and the round from now on, then advance two rounds and tell me who's still poisoned.\u001b[22m   \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m party  @8df2a52c               \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[3;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 I'll first check what my party tool actually does with conditions, then propose what I need.     \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[2m   1 versions\u001b[22m                   \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[4;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_source {\"name\":\"party\"}\u001b[22m                                                             \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22mlog                             \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[5;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_list {}\u001b[22m                                                                             \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;2m+\u001b[39m \u001b[38;5;2maccepted party@8df2a52c\u001b[39m       \u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[6;1H\u001b[2K\u001b[0m\u001b]8;;\u0007  result { \"version\": \"party@8df2a52c\", \"description\": \"Track D&D party members: HP, max HP, te\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[7;1H\u001b[2K\u001b[0m\u001b]8;;\u0007  result party: live party@8df2a52c; history party@8df2a52c; asked for by zoom(0,1)               \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: che\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[8;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 Now I have the full source. I'll add \u001b[38;5;6mstart_combat\u001b[39m, \u001b[38;5;6madvance_round\u001b[39m, \u001b[38;5;6mround_status\u001b[39m, and ticked       \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[9;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 conditions.                                                                                      \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[10;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_propose {\"name\":\"party\",\"description\":\"Track D&D party members: HP, max HP, temp \u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[11;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m  result REJECTED party@c4ca063f: group 1 check 22 {\"action\":\"advance_round\"}: expected \"Pip: p\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@3a23bd60: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[12;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 Good \u2014 my tick arithmetic is off by one: poisoned applied in round 1 with 3 rounds should last   \u001b[0m\u001b]8;;\u0007\u001b[2m\u2502 \u001b[22m\u001b[38;5;1mx\u001b[39m \u001b[38;5;1mrejected roll@9d787d69: gro\u001b[0m...\u001b[0m\u001b]8;;\u0007\u001b[0m\u001b]8;;\u0007\u001b[13;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 into round 3. Fixing both the code and that expectation.                                         \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[14;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_propose {\"changes\":[\"add_condition\",\"start_combat\",\"advance_round\",\"round_status\"\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[15;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m  result REJECTED party@ffd7a6d4: group 1 check 22 {\"action\":\"advance_round\"}: expected \"Pip: p\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 Good news \u2014 the poisoned tick now lands right (still poisoned at round 3); only the \u001b[38;5;6mrounds: 1\u001b[39m    \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[17;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 case is off. Fixing that case's expectation.                                                     \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[18;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_propose {\"changes\":[\"add_condition\",\"start_combat\",\"advance_round\",\"round_status\"\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[19;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m  result REJECTED party@5e546383: group 1 check 22 {\"action\":\"advance_round\"}: expected \"Pip: p\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[20;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 The poisoned timing is right now; only the \u001b[38;5;6mrounds: 1\u001b[39m case differs. My expectation was wrong      \u001b[0m\u001b]8;;\u0007                              "]
[232.1655, "o", "    \u001b[0m\u001b]8;;\u0007\u001b[21;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 there \u2014 fixing that one line.                                                                    \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[22;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_propose {\"changes\":[\"add_condition\",\"start_combat\",\"advance_round\",\"round_status\"\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[23;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m  result REJECTED party@5e546383: group 1 check 24 {\"action\":\"advance_round\"}: expected \"Pip: p\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[24;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 I see the real bug: with \u001b[38;5;6mrounds: 3\u001b[39m in round 1 my \u001b[38;5;6muntil\u001b[39m came out as round 4, not 3 (off-by-one in \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[25;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 the other direction). Fixing the code, not the expectation.                                      \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[26;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_propose {\"changes\":[\"add_condition\",\"start_combat\",\"advance_round\",\"round_status\"\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[27;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[38;5;1m  result REJECTED party@bbe6b56a: replay: 4 of 4 real calls behave differently from party@8df2a\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[28;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 The shape change to the state is intentional (same data, new layout), so I'll declare \u001b[38;5;6minit\u001b[39m in    \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[29;1H\u001b[2K\u001b[0m\u001b]8;;\u0007 \u001b[38;5;6mchanges\u001b[39m and add a migration for the live state.                                                  \u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[30;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2m  call   cell_propose {\"changes\":[\"init\",\"add_condition\",\"start_combat\",\"advance_round\",\"round_\u001b[0m...\u001b[0m\u001b]8;;\u0007                                  \u001b[0m\u001b]8;;\u0007\u001b[32;2H\u001b[?25l\u001b[?2026l"]
