{
  "family": "codeowners",
  "instance": "t3",
  "role": "test",
  "kind": "learnable",
  "rule": "A new module under tally/ gets a line in .github/CODEOWNERS: its path and the team that owns it.",
  "oracle_run": [],
  "followed_commands": [],
  "unique": [
    "installment_plan",
    "installments.py"
  ],
  "hidden_terms": [
    {
      "pattern": "codeowners",
      "allowed_in": []
    },
    {
      "pattern": "\\bowner",
      "allowed_in": []
    },
    {
      "pattern": "@tally/",
      "allowed_in": [
        ".github/CODEOWNERS"
      ]
    }
  ],
  "naive_fails_only_on_rule": true
}
