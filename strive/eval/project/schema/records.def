# tally's records. tools/gen_records.py turns this into tally/_generated/records.py.
#
# Each field is `name: type`, optionally `= default`. Types: str, int, bool,
# decimal, date, list[Record]. A `?` after the type makes the field optional
# (default None).

record LineItem
  description: str
  quantity: int
  unit_price: decimal
  discount_pct: decimal = 0

record Invoice
  number: str
  customer_id: str
  currency: str
  issued_on: date
  terms_days: int = 30
  lines: list[LineItem] = []
  notes: str?

record Customer
  id: str
  name: str
  email: str
  country: str
  vat_id: str?

record Payment
  reference: str
  invoice_number: str
  amount: decimal
  currency: str
  received_on: date

record CreditNote
  number: str
  invoice_number: str
  amount: decimal
  currency: str
  issued_on: date

record Refund
  payment_reference: str
  amount: decimal
  currency: str
  refunded_on: date
