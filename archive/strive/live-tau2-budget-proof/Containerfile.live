FROM strive-vnext
WORKDIR /workspace/strive
COPY . .
RUN bash live-tau2-budget-proof/install-opencode.sh \
 && mkdir -p /opt/strive-native-jail \
 && cp /opt/strive-jail/seccomp.bpf /opt/strive-native-jail/seccomp.bpf \
 && python scripts/build-jail-rootfs.py /opt/strive-native-jail/rootfs \
 && bash scripts/install-tau2.sh
ENV STRIVE_JAIL_HOME=/opt/strive-native-jail
ENTRYPOINT ["bash", "live-tau2-budget-proof/run-container.sh"]
