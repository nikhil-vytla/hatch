+                    <ArtworkImage work={row.work} />
+                    <span className="vs-art-title">{row.work.title}</span>
+                  </button>
+                  <div className="vs-art-copy">
+                    <p>{row.work.artist}</p>
+                    <div className="vs-art-topline">
+                      <span>
+                        {row.rank == null ? "Unscored" : `#${row.rank}`}
+                        {row.tied > 1 ? " tied" : ""}
+                        {collectedIds.has(row.work.id) && (
+                          <Check size={13} aria-label="Collected" />
+                        )}
+                      </span>
+                      <span>
+                        {scoreText(row.score, method)}
+                        {method === "caption" && (
+                          <RankShift
+                            from={rankById.get(row.work.id)}
+                            to={row.rank}
+                          />
+                        )}
+                      </span>
+                    </div>
+                  </div>
+                </motion.article>
+              ))}
+            </AnimatePresence>
+          </motion.div>
+          {shown.length < filtered.length && (
+            <div className="vs-more">
+              <Button secondary onClick={() => setLimit((value) => value + 24)}>
+                Show more <ChevronDown size={15} />
+              </Button>
+              <span>
+                {shown.length} of {filtered.length}
+              </span>
+            </div>
+          )}
+        </>
+      )}
+      {!filtered.length && (
+        <p className="vs-empty-model">
+          No artworks in this medium. Choose another filter.
+        </p>
+      )}
+      <details className="vs-research">
+        <summary>How the rankings work</summary>
+        <p>
+          Jev scores museum metadata, with or without the original museum
+          caption. It does not receive image pixels. Keyword match uses title,
+          subject, style and caption tokens. These are three views of the same{" "}
+          {works.length} artworks.
+        </p>
+        {comparison.complete && (
+          <p>
+            {comparison.shared} of the top {comparison.k} works appear in both
+            Jev rankings. This measures agreement, not retrieval accuracy. Equal
+            scores share a rank; artwork ID breaks display-order ties.
+          </p>
+        )}
+        <p>
+          The field places rank bands in rings around the center. Distance
+          between two artworks does not measure visual similarity. Use Grid for
+          a linear ranking, and open an artwork to compare its scores.
+        </p>
+        <p>
+          The fixed archive comes from twelve museum searches.
+          {result.caption_counts?.descriptive != null &&
+            ` ${result.caption_counts.descriptive} captions describe the image; the others mainly identify materials.`}
+          {result.image_delivery?.matched != null &&
+            ` ${result.image_delivery.matched} artworks have matched Wikimedia previews, with museum images as fallback.`}{" "}
+          Image delivery does not change the ranking.
+        </p>
+        <div className="vs-source-links">
+          <a href={result.documentation} target="_blank" rel="noreferrer">
+            Museum API <ArrowUpRight size={12} />
+          </a>
+          <a href={result.collection_archive} download>
+            Collection data
+          </a>
+          {result.availability?.completed > 0 && (
+            <a href={result.archive} download>
+              Recorded judgments
+            </a>
+          )}
+        </div>
+        <p className="vs-credit">
+          Spatial browsing inspired by{" "}
+          <a
+            href="https://huggingface.co/spaces/webml-community/semantic-image-field"
+            target="_blank"
+            rel="noreferrer"
+          >
+            Semantic Image Field
+          </a>{" "}
+          by Joshua Lochner / Xenova and webml-community, which credits Shridhar
+          Rathi's interaction work. This implementation uses the existing text
+          rankings and an original layout.
+        </p>
+        <details>
+          <summary>Protocol and provenance</summary>
+          <pre className="vs-evidence">
+            {JSON.stringify(
+              {
+                protocol: result.protocol,
+                manifest: result.manifest,
+                collection_sources: result.sources,
+                availability: result.availability,
+                image_delivery: result.image_delivery,
+              },
+              null,
+              2,
+            )}
+          </pre>
+        </details>
+      </details>
+      {selected && inspection.current && (
+        <ArtworkDetails
+          work={selected}
+          inspection={inspection.current}
+          onClose={closeArtwork}
+          onMove={moveArtwork}
+          collected={collectedIds.has(selected.id)}
+          count={collection.length}
+          onCollect={() => toggleCollection(selected)}
+          onRefine={(next) => {
+            opener.current = null;
+            changeQuery(next);
+            closeArtwork();
+          }}
+          manifest={result.manifest}
+        />
+      )}
+    </div>
+  );
 }
