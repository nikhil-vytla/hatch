+.visual-search {
+  --vs-paper: #f5f4ef;
+  --vs-ink: #242c27;
+  --vs-muted: #596259;
+  --vs-line: #d5d9ce;
+  --vs-accent: #24634c;
+  --vs-wash: #e9ece3;
+  --vs-focus: #a75f12;
+  color: var(--vs-ink);
+  margin: 12px 0 32px;
+}
+:root[data-theme="dark"] .visual-search {
+  --vs-paper: #171d19;
+  --vs-ink: #eceee6;
+  --vs-muted: #adb9ac;
+  --vs-line: #3c483f;
+  --vs-accent: #a0cbb2;
+  --vs-wash: #253029;
+  --vs-focus: #efb46b;
+}
+:where(.visual-search) button,
+:where(.visual-search) select {
+  font: inherit;
+}
+.visual-search button {
+  cursor: pointer;
+}
+.visual-search button:disabled {
+  cursor: default;
+  opacity: 0.45;
+}
+.visual-search :is(button, a, input, select, summary):focus-visible {
+  outline: 2px solid var(--vs-focus);
+  outline-offset: 4px;
+}
+.visual-search a {
+  color: var(--vs-accent);
+  text-underline-offset: 3px;
+}
+.vs-sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+.vs-hero {
+  margin-bottom: 22px;
+}
+.vs-archive-line {
+  display: flex;
+  gap: 16px;
+  justify-content: space-between;
+  font-size: 12px;
+  color: var(--vs-muted);
+  margin-bottom: 10px;
+}
+.vs-search-box {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 6px 14px;
+  min-height: 64px;
+  border-bottom: 1px solid var(--vs-ink);
+  background: var(--vs-paper);
+}
+.vs-search-box > svg {
+  flex: 0 0 auto;
+  color: var(--vs-accent);
+}
+.vs-search-box input {
+  width: 100%;
+  min-width: 0;
+  border: 0;
+  outline: 0;
+  background: transparent;
+  color: var(--vs-ink);
+  font:
+    24px/1.5 Georgia,
+    serif;
+}
+.vs-search-box input::placeholder {
+  color: var(--vs-muted);
