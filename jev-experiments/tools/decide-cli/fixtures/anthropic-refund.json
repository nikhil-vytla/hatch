{
  "system": "You are a support agent for Harlow Books. Use tools to look up orders and issue refunds.",
  "tools": [
    {
      "name": "lookup_order",
      "input_schema": { "type": "object", "properties": { "order_id": { "type": "string" } }, "required": ["order_id"] }
    },
    {
      "name": "issue_refund",
      "input_schema": {
        "type": "object",
        "properties": { "order_id": { "type": "string" }, "amount_gbp": { "type": "number" }, "reason": { "type": "string", "enum": ["damaged", "late", "wrong_item", "other"] } },
        "required": ["order_id", "amount_gbp", "reason"]
      }
    }
  ],
  "messages": [
    { "role": "user", "content": "Hi, order HB-44817 arrived with a torn cover. Can I get my money back?" },
    { "role": "assistant", "content": [{ "type": "text", "text": "Let me look that up." }, { "type": "tool_use", "id": "t1", "name": "lookup_order", "input": { "order_id": "HB-44817" } }] },
    { "role": "user", "content": [{ "type": "tool_result", "tool_use_id": "t1", "content": "{\"order_id\": \"HB-44817\", \"total_gbp\": 24.99, \"items\": [\"The Long Garden (hardback)\"]}" }] },
    { "role": "assistant", "content": [{ "type": "tool_use", "id": "t2", "name": "issue_refund", "input": { "order_id": "HB-44871", "amount_gbp": 29.99, "reason": "damaged" } }] }
  ]
}
