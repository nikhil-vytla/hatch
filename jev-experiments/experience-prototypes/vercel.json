{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "ignoreCommand": "if git diff --quiet HEAD^ HEAD -- ..; then exit 0; else exit 1; fi",
  "functions": {
    "api/evaluate.ts": {
      "maxDuration": 60
    },
    "api/compose.ts": {
      "maxDuration": 60
    },
    "api/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(data|judgment-reliability|rewardbench2|outcome-framing|visual-search|icon-studio|arena|decide)/(.*)\\.(json|jsonl)",
      "headers": [
        {
          "key": "Content-Encoding",
          "value": "gzip"
        },
        {
          "key": "Vary",
          "value": "Accept-Encoding"
        }
      ]
    }
  ]
}
