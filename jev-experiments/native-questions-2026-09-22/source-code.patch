+        working-directory: jev-experiments/adapters/typescript
+  python:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v6
+      - run: uv sync --extra dev --frozen
+        working-directory: jev-experiments
+      - run: uv run --frozen pytest -q tests
+        working-directory: jev-experiments
+  go:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-go@v5
+        with: { go-version-file: jev-experiments/adapters/go/go.mod }
+      - run: go test ./...
+        working-directory: jev-experiments/adapters/go
+  rust:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@stable
+      - run: cargo test --locked
+        working-directory: jev-experiments/adapters/rust
