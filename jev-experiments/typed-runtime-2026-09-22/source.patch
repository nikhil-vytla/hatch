diff --git a/.github/workflows/jev-typed-runtime.yml b/.github/workflows/jev-typed-runtime.yml
new file mode 100644
index 0000000..fe1a9a3
--- /dev/null
+++ b/.github/workflows/jev-typed-runtime.yml
@@ -0,0 +1,39 @@
+name: Jev typed runtime and tools
+
+on:
+  pull_request:
+    paths:
+      - "jev-experiments/packages/decision-runtime/**"
+      - "jev-experiments/roadmap/runtime/**"
+      - "jev-experiments/roadmap/routing/**"
+      - "jev-experiments/roadmap/mac/**"
+      - "jev-experiments/roadmap/tsconfig.json"
+      - "jev-experiments/typed-runtime-2026-09-22/**"
+      - ".github/workflows/jev-typed-runtime.yml"
+  push:
+    branches: [main]
+    paths:
+      - "jev-experiments/packages/decision-runtime/**"
+      - "jev-experiments/roadmap/runtime/**"
+      - "jev-experiments/roadmap/routing/**"
+      - "jev-experiments/roadmap/mac/**"
+      - "jev-experiments/roadmap/tsconfig.json"
+      - "jev-experiments/typed-runtime-2026-09-22/**"
+      - ".github/workflows/jev-typed-runtime.yml"
+
+permissions:
+  contents: read
+
+jobs:
+  typed-runtime:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2
+        with:
+          bun-version: "1.3.14"
+      - name: Verify exact archived source without providers or model inference
+        run: >-
+          python3 jev-experiments/typed-runtime-2026-09-22/verify.py
+          --ref "$GITHUB_SHA" --output "$RUNNER_TEMP/typed-runtime-checks"
