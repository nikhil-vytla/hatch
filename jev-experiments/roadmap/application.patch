+
+/* A working scene leads the home page; the catalog remains directly below. */
+.home-play-scene {
+  min-width: 0;
+  padding: 18px;
+  border: 1px solid var(--line);
+  border-radius: 14px;
+  background: var(--surface);
+}
+.home-play-scene .mat-intro {
+  display: none;
+}
+.home-play-scene .mat-expand {
+  display: none;
+}
+.home-scene-caption {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  font: 9px var(--mono);
+  letter-spacing: 0.035em;
+  margin: 1px 0 16px;
+  color: var(--muted);
+}
+.home-scene-caption span:last-child {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  letter-spacing: 0;
+}
+.home-scene-caption i {
+  width: 5px;
+  height: 5px;
+  background: var(--sage);
+  border-radius: 50%;
+}
+.home .hero-copy h1 {
+  font-family: Georgia, "Times New Roman", serif;
+  font-weight: 400;
+  font-size: clamp(40px, 4.1vw, 66px);
+  letter-spacing: -0.05em;
+  line-height: 1.08;
+}
+.home .hero-copy h1 em {
+  font-style: italic;
+}
+.home-play-scene > .text-link {
+  font-size: 12px;
+}
+.home-play-scene .mat-status {
+  margin: 0;
+}
+.home-play-scene .mat-palette {
+  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
+}
+@media (max-width: 760px) {
+  .home-play-scene {
+    padding: 10px;
+  }
+}
+@media (max-width: 600px) {
+  .home .hero-actions {
+    display: none;
+  }
+}
+
+.footer-notes {
+  max-width: 740px;
+}
+.footer-notes > p + p {
+  font-size: 11px;
+  color: var(--muted);
+  margin-top: 7px;
+}
+.builder-credits {
+  margin-top: 12px;
+  font-size: 12px;
+  line-height: 1.65;
+  text-align: left;
+}
+.builder-credits summary {
+  cursor: pointer;
+  color: var(--ink);
+}
+.builder-credits > div {
+  padding: 12px 0;
+}
+.builder-credits a {
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+.builder-credits p {
+  margin: 0 0 12px;
+}
