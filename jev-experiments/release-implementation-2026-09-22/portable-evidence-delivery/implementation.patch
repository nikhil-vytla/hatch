+/** Generate only reviewed evidence shapes; never copy raw transcripts into public assets. */
+export function preparePublicHarnessEvidence(lab: string, destination: string) {
+  const source = resolve(lab, "roadmap/integration/evidence");
+  const sourceReal = realpathSync(source);
+  const checkedSource = (name: string) => {
+    if (
+      !/^[a-z0-9-]+\/(?:summary\.json|summary\.portable\.json|stdout\.jsonl|stdout\.portable\.json|mcp-audit\.jsonl|host\.diff|tests-after\.txt|tests-after\.portable\.json)$/.test(
+        name,
+      )
+    )
+      throw new Error("Unlisted evidence path.");
+    const path = realpathSync(resolve(source, name));
+    if (!path.startsWith(sourceReal + sep))
+      throw new Error("Evidence path escapes its source directory.");
+    return path;
+  };
+  const indexText = readFileSync(resolve(source, "index.json"), "utf8");
+  const index = object(JSON.parse(indexText));
+  if (!Array.isArray(index.runs)) throw new Error("Missing evidence runs.");
+  const files: {
+    path: string;
+    sourceSha256: string;
+    publishedSha256: string;
+    sourcePath: string;
+  }[] = [];
+  const pending = new Map<string, string>();
+  const publish = (name: string, raw: string, result: string, sourcePath = name) => {
+    if (pending.has(name)) throw new Error("Duplicate public evidence path.");
+    files.push({
+      path: name,
+      sourceSha256: sha256(raw),
+      publishedSha256: sha256(result),
+      sourcePath,
+    });
+    pending.set(name, result);
+  };
+  const labReal = realpathSync(lab);
+  for (const value of index.runs) {
+    const run = object(value);
+    if (!["opencode", "claude", "codex"].includes(String(run.harness)))
+      throw new Error("Unsupported evidence harness.");
+    if (typeof run.run !== "string" || !/^[a-z0-9-]+$/.test(run.run))
+      throw new Error("Invalid evidence run name.");
+    const harness = run.harness as Harness;
+    const fixtureFiles = new Set(["sum.ts", "sum.test.ts", "ANALYSIS.md"]);
+    // Additional test basenames are grounded in the retained host diff, not arbitrary host paths.
+    const diffPath = resolve(source, run.run, "host.diff");
+    if (existsSync(diffPath))
+      for (const line of readFileSync(
+        checkedSource(`${run.run}/host.diff`),
+        "utf8",
+      ).split("\n")) {
+        const matched = /^\+\+\+ b\/([A-Za-z0-9_.-]+\.test\.ts)$/.exec(line);
+        if (matched) fixtureFiles.add(matched[1]);
+      }
+    const options: PathProjection = {
+      fixtureFiles,
+      publicFileExists: (path) => {
+        if (!path.startsWith("jev-experiments/")) return false;
+        const resolved = resolve(lab, path.slice("jev-experiments/".length));
+        if (!existsSync(resolved) || !statSync(resolved).isFile()) return false;
+        return realpathSync(resolved).startsWith(labReal + sep);
+      },
+    };
+    for (const [field, filename] of [
+      ["summary", "summary.json"],
+      ["transcript", "stdout.jsonl"],
+      ["audit", "mcp-audit.jsonl"],
+    ] as const) {
+      const name = `${run.run}/${filename}`;
+      const portableName = field === "summary" ? `${run.run}/summary.portable.json` : field === "transcript" ? `${run.run}/stdout.portable.json` : null;
+      const sourceName = run[field];
+      if (sourceName !== name && sourceName !== portableName)
+        throw new Error("Unexpected evidence index link.");
+      const raw = readFileSync(checkedSource(String(sourceName)), "utf8");
+      const retained = sourceName !== name ? decodePortableRecord(raw, field === "summary" ? "summary" : "transcript") : null;
+      if (retained) {
+        const linkage = object(object(run.retainedRecords)[field]);
+        if (retained.harness !== harness || linkage.originalFile !== name || linkage.originalSha256 !== retained.source.sha256 || linkage.derivativeSha256 !== sha256(raw) || linkage.payloadSha256 !== retained.payloadSha256 || linkage.format !== retained.format)
+          throw new Error("Portable evidence index lineage mismatch.");
+      }
+      const metadata = { ...projectionNotice, sourceSha256: sha256(raw), ...(retained ? { retained_record_derivative: {
+        format: retained.format, originalSha256: retained.source.sha256, payloadSha256: retained.payloadSha256,
+        transformation: retained.transformation.id, note: retained.transformation.note,
+      } } : {}) };
+      if (field === "summary") {
+        const selected = pick(object(retained ? retained.payload : JSON.parse(raw)), summaryFields);
+        const result = (retained ? selected : normalize(selected, options)) as RecordValue;
+        publish(
+          name,
+          raw,
+          JSON.stringify(
+            { ...result, publication_projection: metadata },
+            null,
+            2,
+          ) + "\n",
+          String(sourceName),
+        );
+      } else {
+        const events = retained ? retained.payload : raw
+          .split(/\r?\n/)
+          .filter((line) => line.trim())
+          .map((line) => JSON.parse(line));
+        const projected = events.map((event) =>
+          field === "transcript"
+            ? projectTranscriptEvent(harness, event, retained ? { ...options, portableRecord: true } : options)
+            : projectAudit(event, options),
+        );
+        const header = {
+          type: "publication_projection",
+          ...metadata,
+          originalEventCount: events.length,
+        };
+        publish(
+          name,
+          raw,
+          [header, ...projected]
+            .map((event) => JSON.stringify(event))
+            .join("\n") + "\n",
+          String(sourceName),
+        );
+      }
+    }
+    for (const filename of ["host.diff", "tests-after.txt"]) {
+      const name = `${run.run}/${filename}`;
+      const linkage = filename === "tests-after.txt" ? (run.retainedRecords as RecordValue | undefined)?.testsAfter : undefined;
+      if (linkage) {
+        if (existsSync(resolve(source, name))) throw Error("Ambiguous original and derivative test log.");
+        const sourceName = `${run.run}/tests-after.portable.json`;
+        const raw = readFileSync(checkedSource(sourceName), "utf8");
+        const record = decodePortableRecord(raw, "text"), link = object(linkage);
+        if (record.harness !== harness || link.originalFile !== name || link.originalSha256 !== record.source.sha256 || link.derivativeSha256 !== sha256(raw) || link.payloadSha256 !== record.payloadSha256 || link.format !== record.format) throw Error("Portable test-log lineage mismatch.");
+        publish(name, raw, record.payload.text, sourceName);
+      } else {
+        if (!existsSync(resolve(source, name))) continue;
+        const raw = readFileSync(checkedSource(name), "utf8");
+        publish(name, raw, normalizeMachinePaths(raw, options));
+      }
+    }
+  }
+  const publicIndex = normalize(
+    pick(index, ["orderBasis", "runs", "retained_record_index"]),
+    {},
+  ) as RecordValue;
+  for (const value of publicIndex.runs as unknown[]) {
+    const run = object(value);
+    if (run.retainedRecords) {
+      run.summary = `${run.run}/summary.json`;
+      run.transcript = `${run.run}/stdout.jsonl`;
+    }
+  }
+  publicIndex.publication_projection = {
+    ...projectionNotice,
+    sourceSha256: sha256(indexText),
+    files,
+  };
+  pending.set("index.json", JSON.stringify(publicIndex, null, 2) + "\n");
+  // Finish validation before writing any output. The source directory is never a destination.
+  const resolvedDestination = physicalPath(destination);
+  if (
+    relative(sourceReal, resolvedDestination).split(sep)[0] !== ".." ||
+    relative(resolvedDestination, sourceReal).split(sep)[0] !== ".."
+  )
+    throw new Error("Publication must use a separate output directory.");
+  for (const name of pending.keys()) {
+    if (
+      !physicalPath(resolve(destination, name)).startsWith(
+        resolvedDestination + sep,
+      )
+    )
+      throw new Error("Publication output escapes its destination.");
+  }
+  for (const [name, output] of pending) {
+    const path = resolve(destination, name);
+    mkdirSync(dirname(path), { recursive: true });
+    writeFileSync(path, output);
+  }
+  return { runs: index.runs.length, files: pending.size };
+}
