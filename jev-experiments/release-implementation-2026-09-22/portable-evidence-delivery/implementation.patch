+    expect(event.part.state.output.files).toEqual({ "sum.ts": "return n;" });
+    expect(JSON.stringify(event)).not.toContain("omit-this");
+    const codex: any = projectTranscriptEvent("codex", {
+      type: "item.completed",
+      item: {
